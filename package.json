{
  "dependencies": {
    "@auth0/auth0-react": "^2.30.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.223.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@sentry/node": "^11.10.0",
    "dotenv": "^18.0.9",
    "express": "*",
    "express-openid-connect": "^2.20.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "*",
    "socket.io-client": "^4.8.4"
  },
  "scripts": {
    "start": "node server.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --runTestsByPath test/test.js tests/unit/validation.test.js tests/unit/vault.test.js",
    "test:integration": "jest tests/integration --runInBand --env=node",
    "test:e2e": "playwright test --project=chromium --headed",
    "report": "playwright show-report",
    "dev": "concurrently -k -n backend,react \"npm:dev:api\" \"npm:dev:frontend\"",
    "dev:api": "node server.js",
    "dev:frontend": "vite --config frontend/vite.config.mjs --port 5173 --strictPort",
    "build:frontend": "vite build --config frontend/vite.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^5.2.0",
    "artillery": "^2.0.33",
    "concurrently": "^10.0.6",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "vite": "^7.3.7"
  },
  "name": "una-chat-lab05",
  "version": "1.0.0",
  "private": true
}
